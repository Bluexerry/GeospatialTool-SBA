# Backend environment variables (copy this file to server/.env and fill in your values)

POSTGRES_DB=biolivar
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<change-this-password>
DATABASE_URL=postgresql://postgres:<change-this-password>@db:5432/biolivar
JWT_SECRET_KEY=<generate-a-long-random-secret>
ALLOWED_ORIGINS=http://localhost:3000

# Absolute path to the Google Earth Engine service account key JSON
# The file must exist on the HOST machine; Docker mounts it read-only into the container
# Example: GEE_KEY_PATH=C:/secrets/soil-values-predictor-94b681b7d4af.json
GEE_KEY_PATH=<absolute-path-to-gee-key.json>
