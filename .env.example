# Frontend environment variables (copy this file to .env and fill in your values)
# These are embedded at BUILD time — never put secrets here that aren't already public

REACT_APP_AUTH_API_URL=http://localhost:5001
REACT_APP_DATA_API_URL=http://localhost:5002
REACT_APP_ANALYSIS_API_URL=http://localhost:5003
REACT_APP_EARTH_ENGINE_API_URL=http://localhost:5004
REACT_APP_FILE_API_URL=http://localhost:5005
REACT_APP_MAPBOX_TOKEN=<your-mapbox-public-token>
